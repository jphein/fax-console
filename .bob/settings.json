{
  "session": {
    "mcp": false,
    "respectGitIgnore": true,
    "maxReadFile": 1500
  },
  "approval": {
    "outsideWorkspaceAllowed": false
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "python3 .bob/hooks/prompt_gate.py", "timeout": 30 } ] }
    ],
    "PreToolUse": [
      { "hooks": [ { "type": "command", "command": "python3 .bob/hooks/tool_guard.py", "timeout": 30 } ] }
    ]
  }
}
