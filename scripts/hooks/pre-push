#!/usr/bin/env bash
# fax-console pre-push: a push publishes every commit it sends, and rebases and cherry-picks run no
# commit hooks. So each pushed commit's whole history is scanned with the private deny-list (CI runs
# only the generic rules).
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000
rc=0
while read -r _lref lsha _rref _rsha; do
  [ "$lsha" = "$zero" ] && continue                      # deleting a branch publishes nothing
  "$root/scripts/scrub-check.sh" --history "$lsha" --require-deny || rc=1
done
exit "$rc"
